# Copy this file to `.env` and add your real keys. Never commit or share `.env`.
# The agent reads `.env` for secrets; scripts never hardcode them.
# `.env` is already ignored by the included .gitignore.

# Example — uncomment and fill in with your real keys:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# YOUR_API_KEY=
